# Server port.
# v3 defaults to 9999, v4 defaults to 9998.
PORT=

# Heartbeat interval in milliseconds.
# v3 defaults to 60000, v4 defaults to 30000.
HEARTBEAT_INTERVAL=60000

# v3/v4 idle timeout in milliseconds.
IDLE_TIMEOUT=300000

# V4 WebSocket path prefix. Examples: /, /v4, /relay/v4.
PREFIX=/

# v3 default punishment settings.
DEFAULT_PUNISHMENT_TIME=1
DEFAULT_PUNISHMENT_DURATION=5

# Logging.
# Applies to both v3 and v4.
# Supported values: debug, info, warn, error.
LOG_LEVEL=info

# Set to true to force debug logging.
VERBOSE=false
